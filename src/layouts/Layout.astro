---
import RouteLoading from "../components/RouteLoading.astro";

interface Props {
  title: string;
  description: string;
  /** Canonical path beginning with "/", e.g. "/project/" */
  canonicalPath: string;
  /** Label of the active nav item */
  active?: string;
  scrollPage?: boolean;
  robots?: string;
}

const {
  title,
  description,
  canonicalPath,
  active = "",
  scrollPage = false,
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

const canonicalUrl = `https://khongvietnam.com${canonicalPath}`;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Project", href: "/project/" },
  { label: "Concept", href: "/concept/" },
  { label: "Prize", href: "/prize/" },
];

const contact = {
  addressLine: "93/10 No Trang Long st ,Binh Loi Trung ward",
  cityLine: "Ho Chi Minh city, Viet Nam",
  phone: "0913 771 489",
  email: "khongarch@gmail.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://khongvietnam.com/hotlink-ok/og-image.jpg" />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://khongvietnam.com/hotlink-ok/og-image.jpg" />

    <link rel="preload" href="/hotlink-ok/khong-logo-new.jpg" as="image" />

    <title>{title}</title>
    <slot name="structured-data" />
  </head>
  <body class={`${active === "Home" ? "home-page" : "inner-page"}${scrollPage ? " scroll-page" : ""}`}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="site-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a
              class={`nav-link nav-${item.label.toLowerCase()} ${item.label === active ? "active" : ""}`}
              href={item.href}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer" aria-label="Studio contact information">
      <address>
        <span class="contact-address">
          <span class="address-line">Ad : {contact.addressLine}</span>
          <span class="address-line">{contact.cityLine}</span>
        </span>
        <span class="sep" aria-hidden="true">/</span>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>Phone: {contact.phone}</a>
        <span class="sep" aria-hidden="true">/</span>
        <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
      </address>
    </footer>

    <RouteLoading />
  </body>
</html>

<style is:global>
  /* ── Design tokens — ONE font family for the whole site ── */
  @font-face {
    font-family: "KHONG Courier";
    src: url("/fonts/cour.ttf") format("truetype");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "KHONG Courier";
    src: url("/fonts/courbd.ttf") format("truetype");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: "KHONG Courier";
    src: url("/fonts/couri.ttf") format("truetype");
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: "KHONG Courier";
    src: url("/fonts/courbi.ttf") format("truetype");
    font-style: italic;
    font-weight: 700;
    font-display: swap;
  }

  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --faint-ink: #9a9a9a;
    --hairline: #ececec;
    --focus: #a00000;
    /* Single typeface across titles AND body text */
    --font-site: "KHONG Courier", "Courier New", Courier, "Liberation Mono", monospace;
    --header-h: clamp(3.4rem, 7vh, 5rem);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-site);
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
  }

  body {
    height: 100svh;
    max-height: 100svh;
    overflow: hidden; /* every screen fits exactly one viewport — no page scroll */
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-site);
    -webkit-font-smoothing: antialiased;
  }

  .scroll-page {
    height: auto;
    min-height: 100svh;
    max-height: none;
    overflow-y: auto;
  }

  h1, h2, h3, h4, p, address {
    font-family: var(--font-site);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 40;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Header: menu pinned top-right (desktop reference layout) ── */
  .site-header {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: clamp(1.25rem, 2.8vh, 2rem) clamp(1.25rem, 3vw, 3rem) 0.5rem;
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    color: var(--soft-ink);
    font-size: clamp(1rem, 1.15vw, 1.35rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: right;
  }

  .nav-link {
    min-height: 1.6rem;
    transition: color 140ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }

  /* ── Main fills remaining height ── */
  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  /* ── Footer contact bar (shared) ── */
  .site-footer {
    flex-shrink: 0;
    position: relative;
    z-index: 7;
    padding: 10px 1rem max(12px, env(safe-area-inset-bottom));
    background: var(--paper);
    color: var(--soft-ink);
    font-size: clamp(0.66rem, 0.82vw, 0.92rem);
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
  }

  .site-footer address {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  .site-footer .sep {
    color: var(--faint-ink);
  }

  .site-footer .contact-address {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    max-width: 100%;
  }

  .site-footer .address-line {
    max-width: 100%;
  }

  .site-footer .address-line + .address-line::before {
    content: " - ";
  }

  .site-footer a {
    transition: color 140ms ease;
  }

  .site-footer a:hover {
    color: var(--ink);
  }

  /* ── Responsive ── */
  .home-page {
    overflow: hidden;
  }

  .home-page .site-footer {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
  }

  .home-page .site-header {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
  }

  @media (max-width: 768px) {
    .home-page .site-header {
      top: 300px;
      right: 0;
      left: 0;
      max-width: none;
      justify-content: center;
      padding: 0 1rem;
    }

    .home-page .site-nav {
      align-items: center;
      gap: 0.7rem;
      font-size: 26px;
      text-align: center;
    }

    .home-page .site-nav .nav-home {
      display: none;
    }

    .home-page .nav-concept {
      order: 1;
    }

    .home-page .nav-project {
      order: 2;
    }

    .home-page .nav-prize {
      order: 3;
    }

    .site-footer address {
      flex-direction: column;
      white-space: normal;
      gap: 0.15rem;
    }

    .site-footer {
      font-size: 11px;
      padding-bottom: max(24px, env(safe-area-inset-bottom));
    }

    .site-footer .contact-address {
      flex-direction: column;
      gap: 0.15rem;
    }

    .site-footer .address-line + .address-line::before {
      content: "";
    }

    .site-footer .sep {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
