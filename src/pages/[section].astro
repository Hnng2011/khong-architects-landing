---
import RouteLoading from "../components/RouteLoading.astro";

export function getStaticPaths() {
  const staticPages = {
    concept: "Concept",
    prize: "Prize",
  };

  return Object.entries(staticPages).map(([section, title]) => ({
    params: { section },
    props: { title, section },
  }));
}

const { title, section } = Astro.props;
const canonicalUrl = `https://khongvietnam.com/${section}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content={`${title} page for KHONG architects is currently under development.`}
    />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content={`${title} | KHONG architects`} />
    <meta
      property="og:description"
      content={`${title} page for KHONG architects is currently under development.`}
    />
    <meta property="og:image" content="/hotlink-ok/og-image.jpg" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/hotlink-ok/khong-logo.png" as="image" />

    <title>{title} | KHONG architects</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class="page" aria-labelledby="page-title">
      <a class="brand-link" href="/" aria-label="KHONG architects home">
        <img
          class="brand"
          src="/hotlink-ok/khong-logo.png"
          alt="KHONG architects"
          width="720"
          height="711"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <section class="status" aria-describedby="page-note">
        <p class="eyebrow">KHONG architects</p>
        <h1 id="page-title">{title}</h1>
        <p id="page-note">This page is currently under development.</p>
        <a class="home-link" href="/">Back to home</a>
      </section>
    </main>

    <RouteLoading />
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --focus: #a00000;
    --font-mono: "Courier New", Courier, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-mono);
    text-size-adjust: 100%;
  }

  body {
    min-height: 100svh;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: #6f6f6f;
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 5;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .page {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: clamp(2rem, 6vw, 5rem);
    text-align: center;
  }

  .brand-link {
    position: fixed;
    top: clamp(1.5rem, 4vh, 3rem);
    left: 50%;
    transform: translateX(-50%);
  }

  .brand {
    width: clamp(9.5rem, 16vw, 15rem);
    height: auto;
  }

  .status {
    display: grid;
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
    justify-items: center;
    margin-top: clamp(5rem, 12vh, 8rem);
  }

  .eyebrow,
  .status p {
    margin: 0;
    color: var(--soft-ink);
    font-size: clamp(0.9rem, 1.1vw, 1.1rem);
    line-height: 1.5;
  }

  .eyebrow {
    font-weight: 700;
  }

  .status h1 {
    margin: 0;
    color: var(--soft-ink);
    font-size: clamp(2.6rem, 6.8vw, 6rem);
    line-height: 1;
  }

  .home-link {
    margin-top: clamp(0.5rem, 1vw, 1rem);
    border-bottom: 1px solid currentColor;
    color: var(--soft-ink);
    font-size: clamp(1rem, 1.4vw, 1.25rem);
    font-weight: 700;
  }

  @media (max-width: 520px) {
    .brand-link {
      top: 3rem;
    }

    .brand {
      width: 11.5rem;
    }

    .status {
      margin-top: 7rem;
    }
  }
</style>
