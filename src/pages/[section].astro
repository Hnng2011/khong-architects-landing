---
import Layout from "../layouts/Layout.astro";

export function getStaticPaths() {
  const staticPages = {
    concept: "Concept",
    prize: "Prize",
  };

  return Object.entries(staticPages).map(([section, title]) => ({
    params: { section },
    props: { title, section },
  }));
}

const { title, section } = Astro.props;
---

<Layout
  title={`${title} | KHONG architects`}
  description={`${title} — architectural works and notes by KHONG architects, Ho Chi Minh City, Viet Nam.`}
  canonicalPath={`/${section}/`}
  active={title}
>
  <section class="placeholder">
    <p class="eyebrow">KHONG architects</p>
    <h1>{title}</h1>
    <p class="note">This page is currently under development.</p>
    <a class="home-link" href="/">Back to home</a>
  </section>
</Layout>

<style is:global>
  .placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.6vw, 1.1rem);
    padding: clamp(2rem, 6vw, 5rem);
    text-align: center;
  }

  .eyebrow,
  .note {
    margin: 0;
    color: var(--soft-ink);
    font-size: clamp(0.9rem, 1.1vw, 1.05rem);
    line-height: 1.5;
  }

  .eyebrow {
    font-weight: 600;
  }

  h1 {
    margin: 0;
    color: var(--soft-ink);
    font-size: clamp(2.6rem, 6.8vw, 6rem);
    font-weight: 600;
    line-height: 1;
  }

  .home-link {
    margin-top: clamp(0.5rem, 1vw, 1rem);
    border-bottom: 1px solid currentColor;
    color: var(--soft-ink);
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    font-weight: 600;
    transition: color 140ms ease;
  }

  .home-link:hover {
    color: var(--ink);
  }
</style>
