---
import RouteLoading from "../../components/RouteLoading.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevIndex = (index - 1 + projects.length) % projects.length;
    const nextIndex = (index + 1) % projects.length;
    return {
      params: { slug: project.slug },
      props: {
        project,
        prevProject: projects[prevIndex],
        nextProject: projects[nextIndex],
      },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Project", href: "/project/" },
  { label: "Concept", href: "/concept/" },
  { label: "Prize", href: "/prize/" },
];

const contact = {
  address: "93/10 No Trang Long, Binh Loi Trung Ward, Ho Chi Minh City, Viet Nam",
  phone: "0913 771 489",
  email: "khongarch@gmail.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content={`${project.title} - Architectural project by KHONG architects in Ho Chi Minh City, Viet Nam.`}
    />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={`https://khongvietnam.com/project/${project.slug}/`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content={`${project.title} | KHONG architects`} />
    <meta
      property="og:description"
      content={`${project.title} - Architectural project by KHONG architects.`}
    />
    <meta property="og:image" content={project.thumbnail} />
    <meta property="og:url" content={`https://khongvietnam.com/project/${project.slug}/`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${project.title} | KHONG architects`} />
    <meta
      name="twitter:description"
      content={`${project.title} - Architectural project by KHONG architects.`}
    />
    <meta name="twitter:image" content={project.thumbnail} />

    <link rel="preload" href="/hotlink-ok/khong-logo.png" as="image" />
    <title>{project.title} | KHONG architects</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": project.title,
      "description": project.description,
      "image": project.thumbnail,
      "url": `https://khongvietnam.com/project/${project.slug}/`,
      "creator": {
        "@type": "ArchitecturalStudio",
        "name": "KHONG architects"
      },
      "locationCreated": {
        "@type": "Place",
        "name": project.info.address
      }
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <a class="brand-link" href="/" aria-label="KHONG architects home">
        <img
          class="brand-logo"
          src="/hotlink-ok/khong-logo.png"
          alt="KHONG architects"
          width="720"
          height="711"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" class="detail-container">
      <div class="detail-layout-wrapper">
        <div class="layout-left-spacer"></div>
        <div class="project-detail-grid">
          {/* Description Cell */}
          <div class="project-desc-cell">
            <h1 class="project-title">{project.title}</h1>
            
            <div class="project-info-block">
              <h2 class="section-subtitle">Thông tin dự án:</h2>
              <ul class="info-list">
                <li><strong>Địa chỉ:</strong> {project.info.address}</li>
                <li class="info-meta-row">
                  <span><strong>Diện tích:</strong> {project.info.area}</span>
                  <span><strong>Năm hoàn thành:</strong> {project.info.year}</span>
                </li>
              </ul>
            </div>

            <div class="project-desc-block">
              <h2 class="section-subtitle">Thuyết minh dự án:</h2>
              <p class="description-text">{project.description}</p>
            </div>
          </div>

          {/* Image Cells */}
          {project.images.map((imgUrl, i) => (
            <div class="image-cell">
              <img
                src={imgUrl}
                alt={`${project.title} image view ${i + 1}`}
                loading={i < 2 ? "eager" : "lazy"}
                decoding="async"
              />
            </div>
          ))}
        </div>
        <div class="layout-right-spacer"></div>
      </div>
    </main>

    <footer class="contact" aria-label="Studio contact information">
      <address>
        <span>Address: {contact.address}</span>
        <span aria-hidden="true">/</span>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>Phone: {contact.phone}</a>
        <span aria-hidden="true">/</span>
        <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
      </address>
    </footer>

    <!-- Lightbox Modal -->
    <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Image preview">
      <button class="lightbox-close" aria-label="Close preview">&times;</button>
      <button class="lightbox-prev" aria-label="Previous image">&#10094;</button>
      <button class="lightbox-next" aria-label="Next image">&#10095;</button>
      <div class="lightbox-content">
        <img id="lightbox-img" src="" alt="Preview image" />
      </div>
    </div>

    <RouteLoading />

    <script>
      // 1. Dynamic Description Spanning (Vertical)
      function adjustDescSpan() {
        const grid = document.querySelector(".project-detail-grid");
        const desc = document.querySelector(".project-desc-cell");
        if (!(grid instanceof HTMLElement) || !(desc instanceof HTMLElement)) return;

        const isDesktop = window.innerWidth > 1024;
        if (!isDesktop) {
          desc.style.gridRowEnd = "";
          return;
        }

        desc.style.gridRowEnd = "span 1";

        const gridStyles = window.getComputedStyle(grid);
        const gridWidth = grid.clientWidth;
        const columns = 4;
        const gap = parseFloat(gridStyles.gap) || 0;

        const cellHeight = (gridWidth - (columns - 1) * gap) / columns;
        if (cellHeight <= 0) return;

        const descHeight = desc.scrollHeight;
        
        const span = Math.ceil((descHeight + 10) / (cellHeight + gap));
        desc.style.gridRowEnd = `span ${span}`;
      }

      window.addEventListener("load", adjustDescSpan);
      window.addEventListener("resize", adjustDescSpan);
      window.addEventListener("pageshow", adjustDescSpan);
      
      if (document.readyState === "complete") {
        adjustDescSpan();
      } else {
        window.addEventListener("DOMContentLoaded", adjustDescSpan);
      }

      // 2. Lightbox Functionality
      function initLightbox() {
        const lightbox = document.getElementById("lightbox");
        const lightboxImg = document.getElementById("lightbox-img");
        const closeBtn = document.querySelector(".lightbox-close");
        const prevBtn = document.querySelector(".lightbox-prev");
        const nextBtn = document.querySelector(".lightbox-next");
        const images = Array.from(document.querySelectorAll(".image-cell img"));

        if (!lightbox || !lightboxImg || !closeBtn || !prevBtn || !nextBtn || images.length === 0) return;

        let currentIndex = 0;

        function openLightbox(index) {
          if (index < 0 || index >= images.length) return;
          currentIndex = index;
          const img = images[currentIndex];
          if (!(img instanceof HTMLImageElement) || !(lightboxImg instanceof HTMLImageElement)) return;

          lightboxImg.src = img.src;
          lightboxImg.alt = img.alt || "Preview image";
          lightbox.setAttribute("aria-hidden", "false");
          document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
          lightbox.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
          // Clear source after transition to prevent flicker on next open
          setTimeout(() => {
            if (lightbox.getAttribute("aria-hidden") === "true") {
              if (lightboxImg instanceof HTMLImageElement) {
                lightboxImg.src = "";
              }
            }
          }, 350);
        }

        function showNext() {
          const nextIndex = (currentIndex + 1) % images.length;
          openLightbox(nextIndex);
        }

        function showPrev() {
          const prevIndex = (currentIndex - 1 + images.length) % images.length;
          openLightbox(prevIndex);
        }

        images.forEach((img, index) => {
          if (img instanceof HTMLImageElement) {
            img.addEventListener("click", () => {
              openLightbox(index);
            });
          }
        });

        closeBtn.addEventListener("click", closeLightbox);
        prevBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          showPrev();
        });
        nextBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          showNext();
        });
        
        lightbox.addEventListener("click", (e) => {
          if (e.target === lightbox || e.target === lightbox.querySelector(".lightbox-content") || e.target === lightboxImg) {
            closeLightbox();
          }
        });

        document.addEventListener("keydown", (e) => {
          if (lightbox.getAttribute("aria-hidden") === "false") {
            if (e.key === "Escape") {
              closeLightbox();
            } else if (e.key === "ArrowRight") {
              showNext();
            } else if (e.key === "ArrowLeft") {
              showPrev();
            }
          }
        });
      }

      window.addEventListener("load", initLightbox);
      window.addEventListener("pageshow", initLightbox);
      if (document.readyState === "complete") {
        initLightbox();
      } else {
        window.addEventListener("DOMContentLoaded", initLightbox);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --focus: #a00000;
    --font-mono: "Courier New", Courier, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-mono);
    text-size-adjust: 100%;
    scrollbar-width: none;
  }

  html::-webkit-scrollbar {
    display: none;
  }

  body {
    min-height: 100svh;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--soft-ink);
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 8;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header style */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vh, 2rem) 0 0.5rem 0;
    position: relative;
    z-index: 10;
    max-width: 1800px;
    margin: 0 auto;
    width: 100%;
  }

  .brand-link {
    display: block;
    width: min(30vw, 16rem);
    min-width: 10rem;
  }

  .brand-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    color: var(--soft-ink);
    font-size: clamp(1.02rem, 1.25vw, 1.45rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: right;
  }

  .nav-link {
    min-height: 1.65rem;
    letter-spacing: 0;
  }

  /* Main Container */
  .detail-container {
    flex: 1;
    padding: 0.5rem 0 clamp(4rem, 8vh, 6rem);
    max-width: 1800px;
    margin: 0 auto;
    width: 100%;
  }

  .detail-layout-wrapper {
    display: flex;
    gap: 0;
    width: 100%;
  }

  .layout-left-spacer,
  .layout-right-spacer {
    width: min(15vw, 8rem);
    flex-shrink: 0;
  }

  /* Grid Layout Detail */
  .project-detail-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    grid-auto-flow: dense;
    width: 100%;
  }

  .project-desc-cell {
    grid-column: 1 / 3;
    grid-row-start: 1;
    background: transparent;
    padding: 0 1.5rem 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vh, 2rem);
    justify-content: flex-start;
  }

  .project-title {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 0;
    line-height: 1.1;
  }

  .section-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(0.95rem, 1.1vw, 1.15rem);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 0.8rem;
    color: var(--ink);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    line-height: 1.6;
    color: var(--soft-ink);
  }

  .info-list li {
    margin-bottom: 0.4rem;
  }

  .info-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .info-list strong {
    color: var(--ink);
  }

  .description-text {
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    line-height: 1.6;
    color: var(--soft-ink);
    margin: 0;
  }

  .image-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    cursor: pointer;
  }

  .image-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-cell:hover img {
    transform: scale(1.03);
  }

  /* Footer style */
  .contact {
    padding: clamp(1rem, 3vh, 2rem) 1rem;
    background: transparent;
    color: #646464;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.82vw, 0.95rem);
    line-height: 1.35;
    text-align: center;
    border-top: 1px solid #f0f0f0;
    margin-top: auto;
  }

  .contact address {
    display: flex;
    justify-content: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  .contact a:hover {
    color: var(--ink);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .detail-layout-wrapper {
      flex-direction: column;
    }
    .layout-left-spacer,
    .layout-right-spacer {
      display: none;
    }
    .project-detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .project-desc-cell {
      grid-column: 1 / -1;
      grid-row-end: auto !important;
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 1.5rem 1.5rem 0.5rem;
    }

    .detail-container {
      padding: 0 1.5rem 4rem;
    }

    .contact address {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      white-space: normal;
    }

    .contact span[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .project-detail-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Lightbox Styles */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(27, 27, 27, 0.95);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: transparent;
    border: none;
    font-size: 2.5rem;
    font-weight: 200;
    color: #ffffff;
    cursor: pointer;
    z-index: 102;
    line-height: 1;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .lightbox-close:hover {
    color: #cccccc;
    transform: rotate(90deg);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3.5rem);
    cursor: pointer;
    padding: 1.5rem;
    z-index: 102;
    opacity: 0.6;
    transition: opacity 0.3s ease, transform 0.3s ease;
    user-select: none;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.15);
  }

  .lightbox-prev {
    left: 1.5rem;
  }

  .lightbox-next {
    right: 1.5rem;
  }

  @media (max-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      padding: 0.75rem;
      font-size: 2rem;
    }
    .lightbox-prev { left: 0.5rem; }
    .lightbox-next { right: 0.5rem; }
  }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(0.95);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox[aria-hidden="false"] .lightbox-content {
    transform: scale(1);
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }
</style>
