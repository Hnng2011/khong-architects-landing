---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevIndex = (index - 1 + projects.length) % projects.length;
    const nextIndex = (index + 1) % projects.length;
    return {
      params: { slug: project.slug },
      props: {
        project,
        prevProject: projects[prevIndex],
        nextProject: projects[nextIndex],
      },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;
---

<Layout
  title={`${project.title} | KHONG architects`}
  description={`${project.title} - Architectural project by KHONG architects in Ho Chi Minh City, Viet Nam.`}
  canonicalPath={`/project/${project.slug}/`}
  active="Project"
  scrollPage
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      "name": project.title,
      "description": project.description,
      "image": project.thumbnail,
      "url": `https://khongvietnam.com/project/${project.slug}/`,
      "creator": {
        "@type": "ArchitecturalStudio",
        "name": "KHONG architects"
      },
      "locationCreated": {
        "@type": "Place",
        "name": project.info.address
      }
    })} />
  </Fragment>

  <div class="detail-container">
    <div class="project-detail-grid">
      <!-- Description cell -->
      <div class="project-desc-cell">
        <h1 class="project-title">{project.title}</h1>

        <div class="project-info-block">
          <h2 class="section-subtitle">Thông tin dự án:</h2>
          <ul class="info-list">
            <li><strong>Địa chỉ:</strong> {project.info.address}</li>
            <li class="info-meta-row">
              <span><strong>Diện tích:</strong> {project.info.area}</span>
              <span><strong>Năm hoàn thành:</strong> {project.info.year}</span>
            </li>
          </ul>
        </div>

        <div class="project-desc-block">
          <h2 class="section-subtitle">Thuyết minh dự án:</h2>
          <p class="description-text">{project.description}</p>
        </div>

        <nav class="project-pager" aria-label="Project navigation">
          <a href={`/project/${prevProject.slug}/`}>← {prevProject.title}</a>
          <a href="/project/">All projects</a>
          <a href={`/project/${nextProject.slug}/`}>{nextProject.title} →</a>
        </nav>
      </div>

      <!-- Image cells -->
      {
        project.images.map((imgUrl, i) => (
          <div class="image-cell">
            <img
              src={imgUrl}
              alt={`${project.title} image view ${i + 1}`}
              loading={i < 2 ? "eager" : "lazy"}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Image preview">
    <button class="lightbox-close" aria-label="Close preview">&times;</button>
    <button class="lightbox-prev" aria-label="Previous image">&#10094;</button>
    <button class="lightbox-next" aria-label="Next image">&#10095;</button>
    <div class="lightbox-content">
      <img id="lightbox-img" src="" alt="Preview image" />
    </div>
  </div>

  <script>
    // 1. Dynamic Description Spanning (Vertical)
    function adjustDescSpan() {
      const grid = document.querySelector(".project-detail-grid");
      const desc = document.querySelector(".project-desc-cell");
      if (!(grid instanceof HTMLElement) || !(desc instanceof HTMLElement)) return;

      const isDesktop = window.innerWidth > 1024;
      if (!isDesktop) {
        desc.style.gridRowEnd = "";
        return;
      }

      desc.style.gridRowEnd = "span 1";

      const gridStyles = window.getComputedStyle(grid);
      const gridWidth = grid.clientWidth;
      const columns = 4;
      const gap = parseFloat(gridStyles.gap) || 0;

      const cellHeight = (gridWidth - (columns - 1) * gap) / columns;
      if (cellHeight <= 0) return;

      const descHeight = desc.scrollHeight;

      const span = Math.ceil((descHeight + 10) / (cellHeight + gap));
      desc.style.gridRowEnd = `span ${span}`;
    }

    window.addEventListener("load", adjustDescSpan);
    window.addEventListener("resize", adjustDescSpan);
    window.addEventListener("pageshow", adjustDescSpan);

    if (document.readyState === "complete") {
      adjustDescSpan();
    } else {
      window.addEventListener("DOMContentLoaded", adjustDescSpan);
    }

    // 2. Lightbox Functionality
    function initLightbox() {
      const lightbox = document.getElementById("lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const closeBtn = document.querySelector(".lightbox-close");
      const prevBtn = document.querySelector(".lightbox-prev");
      const nextBtn = document.querySelector(".lightbox-next");
      const images = Array.from(document.querySelectorAll(".image-cell img"));

      if (!lightbox || !lightboxImg || !closeBtn || !prevBtn || !nextBtn || images.length === 0) return;

      let currentIndex = 0;

      function openLightbox(index: number) {
        if (index < 0 || index >= images.length) return;
        currentIndex = index;
        const img = images[currentIndex];
        if (!(img instanceof HTMLImageElement) || !(lightboxImg instanceof HTMLImageElement)) return;

        lightboxImg.src = img.src;
        lightboxImg.alt = img.alt || "Preview image";
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      }

      function closeLightbox() {
        lightbox!.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        setTimeout(() => {
          if (lightbox!.getAttribute("aria-hidden") === "true") {
            if (lightboxImg! instanceof HTMLImageElement) {
              lightboxImg!.src = "";
            }
          }
        }, 350);
      }

      function showNext() {
        openLightbox((currentIndex + 1) % images.length);
      }

      function showPrev() {
        openLightbox((currentIndex - 1 + images.length) % images.length);
      }

      images.forEach((img, index) => {
        if (img instanceof HTMLImageElement) {
          img.addEventListener("click", () => {
            openLightbox(index);
          });
        }
      });

      closeBtn.addEventListener("click", closeLightbox);
      prevBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        showPrev();
      });
      nextBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        showNext();
      });

      lightbox.addEventListener("click", (e) => {
        if (e.target === lightbox || e.target === lightbox.querySelector(".lightbox-content") || e.target === lightboxImg) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (e) => {
        if (lightbox!.getAttribute("aria-hidden") === "false") {
          if (e.key === "Escape") {
            closeLightbox();
          } else if (e.key === "ArrowRight") {
            showNext();
          } else if (e.key === "ArrowLeft") {
            showPrev();
          }
        }
      });
    }

    window.addEventListener("load", initLightbox);
    window.addEventListener("pageshow", initLightbox);
    if (document.readyState === "complete") {
      initLightbox();
    } else {
      window.addEventListener("DOMContentLoaded", initLightbox);
    }
  </script>
</Layout>

<style is:global>
  .detail-container {
    width: 100%;
    max-width: 1800px;
    margin: 0 auto;
    padding: 0.5rem min(15vw, 8rem) clamp(3rem, 6vh, 5rem);
  }

  /* Grid Layout Detail */
  .project-detail-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
    grid-auto-flow: dense;
    width: 100%;
  }

  .project-desc-cell {
    grid-column: 1 / 3;
    grid-row-start: 1;
    padding-right: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 2rem);
    justify-content: flex-start;
  }

  .project-title {
    font-size: clamp(1.7rem, 2.8vw, 2.6rem);
    font-weight: 600;
    margin: 0;
    line-height: 1.15;
  }

  .section-subtitle {
    font-size: clamp(0.92rem, 1.05vw, 1.12rem);
    font-weight: 600;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    line-height: 1.65;
    color: var(--soft-ink);
  }

  .info-list li {
    margin-bottom: 0.4rem;
  }

  .info-meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .info-list strong,
  .description-text strong {
    color: var(--ink);
  }

  .description-text {
    font-size: clamp(0.85rem, 0.95vw, 1rem);
    line-height: 1.7;
    color: var(--soft-ink);
    margin: 0;
    white-space: pre-line;
  }

  .project-pager {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
    padding-top: clamp(1rem, 2vh, 1.5rem);
    border-top: 1px solid var(--hairline);
    color: var(--soft-ink);
    font-size: clamp(0.78rem, 0.9vw, 0.95rem);
    font-weight: 400;
  }

  .project-pager a {
    transition: color 140ms ease;
  }

  .project-pager a:hover {
    color: var(--ink);
  }

  .image-cell {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e6e6e6;
    cursor: pointer;
  }

  .image-cell img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .image-cell:hover img {
    transform: scale(1.03);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .detail-container {
      padding-left: clamp(1.25rem, 4vw, 3rem);
      padding-right: clamp(1.25rem, 4vw, 3rem);
    }

    .project-detail-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .project-desc-cell {
      grid-column: 1 / -1;
      grid-row-end: auto !important;
      padding-right: 0;
    }
  }

  @media (max-width: 520px) {
    .project-detail-grid {
      grid-template-columns: 1fr;
    }

    .project-pager {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 0.4rem;
      font-size: clamp(0.65rem, 2.5vw, 0.78rem);
    }

    .project-pager a {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: center;
    }

    .project-pager a:first-child {
      text-align: left;
    }

    .project-pager a:last-child {
      text-align: right;
    }
  }

  /* ── Lightbox ── */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(27, 27, 27, 0.95);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox[aria-hidden="false"] {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-close {
    position: absolute;
    top: 2rem;
    right: 2rem;
    background: transparent;
    border: none;
    font-family: var(--font-site);
    font-size: 2.5rem;
    font-weight: 200;
    color: #ffffff;
    cursor: pointer;
    z-index: 102;
    line-height: 1;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .lightbox-close:hover {
    color: #cccccc;
    transform: rotate(90deg);
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: transparent;
    border: none;
    font-family: var(--font-site);
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3.5rem);
    cursor: pointer;
    padding: 1.5rem;
    z-index: 102;
    opacity: 0.6;
    transition: opacity 0.3s ease, transform 0.3s ease;
    user-select: none;
  }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.15);
  }

  .lightbox-prev { left: 1.5rem; }
  .lightbox-next { right: 1.5rem; }

  .lightbox-content {
    max-width: 90vw;
    max-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(0.95);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox[aria-hidden="false"] .lightbox-content {
    transform: scale(1);
  }

  .lightbox-content img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 768px) {
    .lightbox-prev,
    .lightbox-next {
      padding: 0.75rem;
      font-size: 2rem;
    }

    .lightbox-prev { left: 0.5rem; }
    .lightbox-next { right: 0.5rem; }
  }
</style>
