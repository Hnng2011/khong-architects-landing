---
import RouteLoading from "../../components/RouteLoading.astro";
import { projects } from "../../data/projects.js";

export function getStaticPaths() {
  return projects.map((project, index) => {
    const prevIndex = (index - 1 + projects.length) % projects.length;
    const nextIndex = (index + 1) % projects.length;
    return {
      params: { slug: project.slug },
      props: {
        project,
        prevProject: projects[prevIndex],
        nextProject: projects[nextIndex],
      },
    };
  });
}

const { project, prevProject, nextProject } = Astro.props;

const navItems = [
  { label: "Home", href: "/" },
  { label: "Project", href: "/project/" },
  { label: "Concept", href: "/concept/" },
  { label: "Prize", href: "/prize/" },
];

const contact = {
  address: "93/10 No Trang Long, Binh Loi Trung Ward, Ho Chi Minh City, Viet Nam",
  phone: "0913 771 489",
  email: "khongarch@gmail.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content={`${project.title} - Architectural project by KHONG architects in Ho Chi Minh City, Viet Nam.`}
    />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={`https://khongarchitects.vn/project/${project.slug}/`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content={`${project.title} | KHONG architects`} />
    <meta
      property="og:description"
      content={`${project.title} - Architectural project by KHONG architects.`}
    />
    <meta property="og:image" content={project.thumbnail} />
    <meta property="og:url" content={`https://khongarchitects.vn/project/${project.slug}/`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/hotlink-ok/khong-logo.png" as="image" />
    <title>{project.title} | KHONG architects</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <a class="brand-link" href="/" aria-label="KHONG architects home">
        <img
          class="brand-logo"
          src="/hotlink-ok/khong-logo.png"
          alt="KHONG architects"
          width="720"
          height="711"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" class="detail-container">
      {
        project.layout === "horizontal" ? (
          /* Layout Ngang / Horizontal layout matching Image 2 */
          <div class="layout-horizontal">
            <div class="left-column">
              <h1 class="project-title">{project.title}</h1>
              
              <div class="project-info-block">
                <h2 class="section-subtitle">Thông tin dự án:</h2>
                <ul class="info-list">
                  <li><strong>Địa chỉ:</strong> {project.info.address}</li>
                  <li><strong>Diện tích:</strong> {project.info.area}</li>
                  <li><strong>Năm hoàn thành:</strong> {project.info.year}</li>
                </ul>
              </div>

              <div class="project-desc-block">
                <h2 class="section-subtitle">Thuyết minh dự án:</h2>
                <p class="description-text">{project.description}</p>
              </div>

              {project.images[0] && (
                <div class="landscape-image-wrapper">
                  <img src={project.images[0]} alt={`${project.title} landscape view`} loading="lazy" decoding="async" />
                </div>
              )}
            </div>

            <div class="right-column">
              <div class="portrait-images-grid">
                {project.images.slice(1).map((imgUrl, i) => (
                  <div class="portrait-image-wrapper">
                    <img src={imgUrl} alt={`${project.title} portrait view ${i + 1}`} loading="lazy" decoding="async" />
                  </div>
                ))}
              </div>
            </div>
          </div>
        ) : (
          /* Layout Dọc / Vertical layout matching Image 1 */
          <div class="layout-vertical">
            <div class="vertical-intro">
              <h1 class="project-title">{project.title}</h1>
              <div class="intro-grid">
                <div class="project-info-block">
                  <h2 class="section-subtitle">Thông tin dự án:</h2>
                  <ul class="info-list">
                    <li><strong>Địa chỉ:</strong> {project.info.address}</li>
                    <li><strong>Diện tích:</strong> {project.info.area}</li>
                    <li><strong>Năm hoàn thành:</strong> {project.info.year}</li>
                  </ul>
                </div>
                <div class="project-desc-block">
                  <h2 class="section-subtitle">Thuyết minh dự án:</h2>
                  <p class="description-text">{project.description}</p>
                </div>
              </div>
            </div>

            <div class="vertical-images-grid">
              {project.images.map((imgUrl, i) => (
                <div class="vertical-image-wrapper">
                  <img src={imgUrl} alt={`${project.title} detail view ${i + 1}`} loading="lazy" decoding="async" />
                </div>
              ))}
            </div>
          </div>
        )
      }

      {/* Pagination Navigation matching Image 1 */}
      <nav class="project-pagination" aria-label="Projects navigation">
        <a class="pagination-link prev" href={`/project/${prevProject.slug}/`}>
          &lt;- Previous Project
        </a>
        <a class="pagination-link next" href={`/project/${nextProject.slug}/`}>
          Next Project -&gt;
        </a>
      </nav>
    </main>

    <footer class="contact" aria-label="Studio contact information">
      <address>
        <span>Address: {contact.address}</span>
        <span aria-hidden="true">/</span>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>Phone: {contact.phone}</a>
        <span aria-hidden="true">/</span>
        <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
      </address>
    </footer>

    <RouteLoading />
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --focus: #a00000;
    --font-mono: "Courier New", Courier, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-mono);
    text-size-adjust: 100%;
  }

  body {
    min-height: 100svh;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--soft-ink);
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 8;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header style */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: clamp(1.5rem, 4vh, 3rem) clamp(1.5rem, 4vw, 4rem);
    position: relative;
    z-index: 10;
  }

  .brand-link {
    display: block;
    width: min(8vw, 6rem);
    min-width: 4rem;
  }

  .brand-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    color: var(--soft-ink);
    font-size: clamp(1.02rem, 1.25vw, 1.45rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: right;
  }

  .nav-link {
    min-height: 1.65rem;
    letter-spacing: 0;
  }

  /* Main Container */
  .detail-container {
    flex: 1;
    padding: 0 clamp(1.5rem, 4vw, 4rem) clamp(3rem, 6vh, 4rem);
    max-width: 1440px;
    margin: 0 auto;
    width: 100%;
  }

  .project-title {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .section-subtitle {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 1.2vw, 1.25rem);
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 0.8rem;
    color: var(--ink);
  }

  .info-list {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: clamp(0.85rem, 1vw, 1.05rem);
    line-height: 1.6;
    color: var(--soft-ink);
  }

  .info-list li {
    margin-bottom: 0.4rem;
  }

  .info-list strong {
    color: var(--ink);
  }

  .description-text {
    font-size: clamp(0.85rem, 1vw, 1.05rem);
    line-height: 1.6;
    color: var(--soft-ink);
    margin: 0;
  }

  /* Layout 2: Horizontal split */
  .layout-horizontal {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .left-column {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vh, 3.5rem);
  }

  .landscape-image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
  }

  .landscape-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .right-column {
    height: 100%;
  }

  .portrait-images-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .portrait-image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
  }

  .portrait-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Layout 1: Vertical grid */
  .layout-vertical {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .vertical-intro {
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 2rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 4vw, 4rem);
  }

  .vertical-images-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
  }

  .vertical-image-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
  }

  .vertical-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Pagination */
  .project-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: clamp(4rem, 8vh, 6rem);
    padding-top: 2rem;
    border-top: 1px solid #e0e0e0;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 1.2vw, 1.15rem);
    font-weight: 700;
  }

  .pagination-link {
    color: var(--soft-ink);
    transition: color 0.3s ease;
  }

  .pagination-link:hover {
    color: var(--ink);
  }

  /* Footer style */
  .contact {
    padding: clamp(1rem, 3vh, 2rem) 1rem;
    background: transparent;
    color: #646464;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.82vw, 0.95rem);
    line-height: 1.35;
    text-align: center;
    border-top: 1px solid #f0f0f0;
    margin-top: auto;
  }

  .contact address {
    display: flex;
    justify-content: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .layout-horizontal {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .vertical-images-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .header {
      padding: 1.5rem;
    }

    .detail-container {
      padding: 0 1.5rem 3rem;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .vertical-images-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact address {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      white-space: normal;
    }

    .contact span[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .portrait-images-grid,
    .vertical-images-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
