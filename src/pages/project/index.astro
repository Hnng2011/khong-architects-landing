---
import RouteLoading from "../../components/RouteLoading.astro";
import { projects } from "../../data/projects.js";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Project", href: "/project/" },
  { label: "Concept", href: "/concept/" },
  { label: "Prize", href: "/prize/" },
];

const contact = {
  address: "93/10 No Trang Long, Binh Loi Trung Ward, Ho Chi Minh City, Viet Nam",
  phone: "0913 771 489",
  email: "khongarch@gmail.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Explore architectural projects by KHONG architects in Ho Chi Minh City, Viet Nam."
    />
    <meta name="robots" content="noindex, follow" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href="https://khongvietnam.com/project/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.json" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content="Projects | KHONG architects" />
    <meta
      property="og:description"
      content="Explore architectural projects by KHONG architects in Ho Chi Minh City, Viet Nam."
    />
    <meta property="og:image" content="/hotlink-ok/og-image.jpg" />
    <meta property="og:url" content="https://khongvietnam.com/project/" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/hotlink-ok/khong-logo.png" as="image" />
    <title>Projects | KHONG architects</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="header">
      <a class="brand-link" href="/" aria-label="KHONG architects home">
        <img
          class="brand-logo"
          src="/hotlink-ok/khong-logo.png"
          alt="KHONG architects"
          width="720"
          height="711"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a class={`nav-link ${item.label === "Project" ? "active" : ""}`} href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main" class="project-container">
      <h1 class="sr-only">Our Projects</h1>

      <div class="list-layout-wrapper">
        <div class="layout-left-spacer"></div>
        <div class="projects-grid">
          {
            projects.map((project) => (
              <a class="project-card" href={`/project/${project.slug}/`} aria-label={`View ${project.title}`}>
                <span class="project-title">{project.title}</span>
                <div class="project-image-wrapper">
                  <img
                    class="project-image"
                    src={project.thumbnail}
                    alt={project.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </a>
            ))
          }
        </div>
        <div class="layout-right-spacer"></div>
      </div>

      <div class="scroll-status-wrapper">
        <span class="scroll-number">01</span>
        <div class="scroll-progress-container">
          <div class="scroll-progress-bar" id="scroll-progress"></div>
        </div>
        <span class="scroll-number" id="scroll-total-count">{projects.length.toString().padStart(2, '0')}</span>
      </div>
    </main>

    <footer class="contact" aria-label="Studio contact information">
      <address>
        <span>Address: {contact.address}</span>
        <span aria-hidden="true">/</span>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>Phone: {contact.phone}</a>
        <span aria-hidden="true">/</span>
        <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
      </address>
    </footer>

    <RouteLoading />

    <script>
      function initScrollProgress() {
        const grid = document.querySelector(".projects-grid");
        const progressContainer = document.querySelector(".scroll-status-wrapper");
        const bar = document.getElementById("scroll-progress");
        if (!(grid instanceof HTMLElement) || !(progressContainer instanceof HTMLElement) || !(bar instanceof HTMLElement)) return;

        const total = grid.scrollWidth - grid.clientWidth;

        // Translate vertical wheel scroll to horizontal card-by-card snap scroll
        let isThrottled = false;
        grid.addEventListener("wheel", (e) => {
          if (e.deltaY !== 0) {
            e.preventDefault();
            if (isThrottled) return;
            isThrottled = true;
            setTimeout(() => { isThrottled = false; }, 400);

            const card = grid.querySelector(".project-card");
            if (!card) return;
            const cardWidth = card.clientWidth;
            const gap = parseFloat(window.getComputedStyle(grid).gap) || 0;
            const step = cardWidth + gap;

            if (e.deltaY > 0) {
              grid.scrollBy({ left: step, behavior: "smooth" });
            } else {
              grid.scrollBy({ left: -step, behavior: "smooth" });
            }
          }
        }, { passive: false });

        const barWidth = 30; // matches CSS width

        function updateProgress() {
          const scrollTotal = grid.scrollWidth - grid.clientWidth;
          if (scrollTotal <= 0) {
            progressContainer.style.display = "none";
          } else {
            progressContainer.style.display = "flex";
            const ratio = grid.scrollLeft / scrollTotal;
            const containerWidth = bar.parentElement ? bar.parentElement.clientWidth : 100;
            const maxLeft = containerWidth - barWidth;
            const leftPos = ratio * maxLeft;
            bar.style.left = `${leftPos}px`;
          }
        }

        if (total <= 0) {
          progressContainer.style.display = "none";
        } else {
          progressContainer.style.display = "flex";
          updateProgress();
          grid.addEventListener("scroll", updateProgress);
        }
      }

      window.addEventListener("load", initScrollProgress);
      window.addEventListener("resize", initScrollProgress);
      window.addEventListener("pageshow", initScrollProgress);
      if (document.readyState === "complete") {
        initScrollProgress();
      } else {
        window.addEventListener("DOMContentLoaded", initScrollProgress);
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --focus: #a00000;
    --font-mono: "Courier New", Courier, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-mono);
    text-size-adjust: 100%;
  }

  body {
    height: 100vh;
    height: 100svh;
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 8;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Header style */
  .header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: clamp(1.5rem, 3vh, 2rem) 0 0.5rem 0;
    position: relative;
    z-index: 10;
    max-width: 1800px;
    margin: 0 auto;
    width: 100%;
  }

  .brand-link {
    display: block;
    width: min(30vw, 16rem);
    min-width: 10rem;
  }

  .brand-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .site-nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    color: var(--soft-ink);
    font-size: clamp(1.02rem, 1.25vw, 1.45rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: right;
  }

  .nav-link {
    min-height: 1.65rem;
    letter-spacing: 0;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link.active {
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
  }

  /* Main Container */
  .project-container {
    flex: 1;
    padding: 0 0 clamp(1rem, 2vh, 2rem);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    margin-top: 0.5rem;
  }

  /* Scroll progress indicator wrapper */
  .scroll-status-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    margin: 2.5rem auto 0 auto;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 0.9vw, 0.9rem);
    color: var(--soft-ink);
    user-select: none;
    flex-shrink: 0;
  }

  .scroll-progress-container {
    flex: 1;
    height: 1px;
    background: #e0e0e0;
    margin: 0 1.5rem;
    position: relative;
    overflow: visible;
  }

  .scroll-progress-bar {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: 30px;
    background: var(--ink);
    transition: left 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-number {
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .list-layout-wrapper {
    display: flex;
    gap: 0;
    width: 100%;
    overflow: hidden;
  }

  .layout-left-spacer,
  .layout-right-spacer {
    width: min(15vw, 8rem);
    flex-shrink: 0;
  }

  /* Grid Layout */
  .projects-grid {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 1.5rem;
    scrollbar-width: none;
    
    /* Scroll snap settings */
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-left: 0;
  }

  /* Custom scrollbar styling */
  .projects-grid::-webkit-scrollbar {
    display: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card {
    position: relative;
    display: block;
    height: clamp(20rem, 50vh, 32rem);
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    overflow: hidden;
    background: #f5f5f5;
    border: 1px solid #e0e0e0;
    
    /* Scroll snap align */
    scroll-snap-align: start;
    
    /* Reveal animation */
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Stagger delays */
  .project-card:nth-child(1) { animation-delay: 0.05s; }
  .project-card:nth-child(2) { animation-delay: 0.1s; }
  .project-card:nth-child(3) { animation-delay: 0.15s; }
  .project-card:nth-child(4) { animation-delay: 0.2s; }
  .project-card:nth-child(5) { animation-delay: 0.25s; }
  .project-card:nth-child(6) { animation-delay: 0.3s; }
  .project-card:nth-child(7) { animation-delay: 0.35s; }
  .project-card:nth-child(8) { animation-delay: 0.4s; }

  .project-title {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 5;
    font-family: var(--font-mono);
    font-size: clamp(0.75rem, 1vw, 1rem);
    font-weight: 700;
    color: var(--ink);
    background: rgba(255, 255, 255, 0.85);
    padding: 0.35rem 0.7rem;
    backdrop-filter: blur(4px);
    transition: background 0.3s ease;
  }

  .project-image-wrapper {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-card:hover .project-title {
    background: rgba(255, 255, 255, 1);
  }

  /* Footer style */
  .contact {
    padding: clamp(1rem, 3vh, 2rem) 1rem;
    background: transparent;
    color: #646464;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.82vw, 0.95rem);
    line-height: 1.35;
    text-align: center;
    border-top: 1px solid #f0f0f0;
    margin-top: auto;
  }

  .contact address {
    display: flex;
    justify-content: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  .contact a:hover {
    color: var(--ink);
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    .list-layout-wrapper {
      flex-direction: column;
    }
    .layout-left-spacer,
    .layout-right-spacer {
      display: none;
    }
    .projects-grid {
      grid-template-columns: repeat(3, 1fr);
      display: grid;
    }
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .header {
      padding: 1.5rem 1.5rem 0.5rem;
    }

    .project-container {
      padding: 0 1.5rem 4rem;
    }

    .contact address {
      flex-direction: column;
      align-items: center;
      gap: 0.25rem;
      white-space: normal;
    }

    .contact span[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
