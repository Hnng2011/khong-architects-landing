---
import Layout from "../../layouts/Layout.astro";
import { projects } from "../../data/projects.js";
---

<Layout
  title="Projects | KHONG architects"
  description="Explore architectural projects by KHONG architects in Ho Chi Minh City, Viet Nam."
  canonicalPath="/project/"
  active="Project"
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Projects | KHONG architects",
      "url": "https://khongvietnam.com/project/",
      "description": "Explore architectural projects by KHONG architects in Ho Chi Minh City, Viet Nam."
    })} />
  </Fragment>

  <div class="project-container">
    <h1 class="sr-only">Our Projects</h1>

    <div class="projects-grid" aria-label="Project list">
      {
        projects.map((project, index) => (
          <a class="project-card" href={`/project/${project.slug}/`} aria-label={`View ${project.title}`}>
            <div class="project-image-wrapper">
              <img
                class="project-image"
                src={project.thumbnail}
                alt={project.title}
                loading="lazy"
                decoding="async"
              />
              <div class="project-card-overlay">
                <span class="project-number">{(index + 1).toString().padStart(2, "0")}</span>
                <h2 class="project-title">{project.title}</h2>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <div class="scroll-status-wrapper">
      <span class="scroll-number">01</span>
      <div class="scroll-progress-container">
        <div class="scroll-progress-bar" id="scroll-progress"></div>
      </div>
      <span class="scroll-number" id="scroll-total-count">{projects.length.toString().padStart(2, "0")}</span>
    </div>
  </div>

  <script>
    function initScrollProgress() {
      const container = document.querySelector(".project-container");
      const grid = document.querySelector(".projects-grid");
      const progressContainer = document.querySelector(".scroll-status-wrapper");
      const bar = document.getElementById("scroll-progress");
      if (!(container instanceof HTMLElement) || !(grid instanceof HTMLElement) || !(progressContainer instanceof HTMLElement) || !(bar instanceof HTMLElement)) return;

      // Trackpad deltas are continuous; let the browser snap after the gesture ends.
      container.addEventListener("wheel", (event) => {
        if (window.innerWidth <= 768 || grid.scrollWidth <= grid.clientWidth || event.deltaY === 0) return;
        event.preventDefault();
        const unit = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? 16 : event.deltaMode === WheelEvent.DOM_DELTA_PAGE ? grid.clientWidth : 1;
        grid.scrollLeft += event.deltaY * unit;
      }, { passive: false });

      const barWidth = 30; // matches CSS width

      function updateProgress() {
        const scrollTotal = grid.scrollWidth - grid.clientWidth;
        if (scrollTotal <= 0) {
          progressContainer.style.display = "none";
          return;
        }
        progressContainer.style.display = "flex";
        const ratio = grid.scrollLeft / scrollTotal;
        const containerWidth = bar.parentElement ? bar.parentElement.clientWidth : 100;
        const maxLeft = containerWidth - barWidth;
        bar.style.left = `${ratio * maxLeft}px`;
      }

      grid.addEventListener("scroll", updateProgress);
      window.addEventListener("resize", updateProgress);
      window.addEventListener("pageshow", updateProgress);
      updateProgress();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initScrollProgress, { once: true });
    } else initScrollProgress();
  </script>
</Layout>

<style is:global>
  .project-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 0.5rem 0 clamp(1rem, 2vh, 2rem);
    min-height: 0; /* allow the horizontal scroller to size correctly */
  }

  /* ── Horizontal snap scroller ── */
  .projects-grid {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    width: 100%;
    padding: 0 min(15vw, 8rem);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    scroll-padding-left: min(15vw, 8rem);
  }

  .projects-grid::-webkit-scrollbar {
    display: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .project-card {
    position: relative;
    display: block;
    height: clamp(20rem, 52vh, 32rem);
    aspect-ratio: 1 / 1;
    flex-shrink: 0;
    overflow: hidden;
    background: #111111;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 4px;
    scroll-snap-align: start;
    opacity: 0;
    animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .project-card:nth-child(1) { animation-delay: 0.05s; }
  .project-card:nth-child(2) { animation-delay: 0.10s; }
  .project-card:nth-child(3) { animation-delay: 0.15s; }
  .project-card:nth-child(4) { animation-delay: 0.20s; }
  .project-card:nth-child(5) { animation-delay: 0.25s; }
  .project-card:nth-child(6) { animation-delay: 0.30s; }
  .project-card:nth-child(7) { animation-delay: 0.35s; }
  .project-card:nth-child(8) { animation-delay: 0.40s; }

  .project-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.25rem, 2.2vw, 2rem);
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.88) 0%,
      rgba(10, 10, 10, 0.42) 45%,
      rgba(10, 10, 10, 0) 85%
    );
    transition: background 0.4s ease;
  }

  .project-number {
    font-size: clamp(0.72rem, 0.85vw, 0.88rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.65);
    letter-spacing: 0.12em;
    margin-bottom: 0.35rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s ease;
  }

  .project-title {
    margin: 0;
    font-size: clamp(1.05rem, 1.3vw, 1.35rem);
    font-weight: 500;
    color: #ffffff;
    line-height: 1.25;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover .project-card-overlay {
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.95) 0%,
      rgba(10, 10, 10, 0.52) 55%,
      rgba(10, 10, 10, 0.05) 100%
    );
  }

  .project-card:hover .project-number,
  .project-card:hover .project-title {
    transform: translateY(-3px);
  }

  .project-card:hover .project-number {
    color: #ffffff;
  }

  .project-card:hover .project-image {
    transform: scale(1.06);
  }

  /* ── Scroll progress ── */
  .scroll-status-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: 400px;
    margin: clamp(1.5rem, 4vh, 2.5rem) auto 0;
    font-size: clamp(0.75rem, 0.9vw, 0.9rem);
    color: var(--soft-ink);
    user-select: none;
    flex-shrink: 0;
  }

  .scroll-progress-container {
    flex: 1;
    height: 1px;
    background: #e0e0e0;
    margin: 0 1.5rem;
    position: relative;
    overflow: visible;
  }

  .scroll-progress-bar {
    position: absolute;
    top: -1px;
    left: 0;
    height: 3px;
    width: 30px;
    background: var(--ink);
    transition: left 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-number {
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .projects-grid {
      padding: 0 clamp(1rem, 4vw, 3rem);
      scroll-padding-left: clamp(1rem, 4vw, 3rem);
    }

    .project-card {
      height: clamp(18rem, 46vh, 28rem);
    }
  }

  @media (max-width: 768px) {
    /* Mobile reference: vertical stacked cards, natural page scroll */
    body {
      overflow: auto;
    }

    .project-container {
      padding: 0 0 2rem;
      display: block;
    }

    .projects-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: clamp(0.75rem, 2.5vw, 1.25rem);
      padding: 0 clamp(1rem, 4vw, 2rem);
      overflow: visible;
      scroll-snap-type: none;
    }

    .project-card {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }

    .scroll-status-wrapper {
      display: none !important;
    }
  }

  @media (max-width: 480px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
