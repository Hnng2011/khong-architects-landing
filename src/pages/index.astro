---
import Layout from "../layouts/Layout.astro";

const contact = {
  addressLine: "93/10 No Trang Long st ,Binh Loi Trung ward",
  cityLine: "Ho Chi Minh city, Viet Nam",
  email: "khongarch@gmail.com",
};
---

<Layout
  title="KHONG architects — Architectural Studio in Ho Chi Minh City, Viet Nam"
  description="KHONG architects studio in Ho Chi Minh City, Viet Nam. Explore projects, concepts, awards, and contact information."
  canonicalPath="/"
  active="Home"
  noFooter
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ArchitecturalStudio",
      "name": "KHONG architects",
      "url": "https://khongvietnam.com/",
      "logo": "https://khongvietnam.com/hotlink-ok/khong-logo.png",
      "image": "https://khongvietnam.com/hotlink-ok/khong-logo.png",
      "description": "KHONG architects is an architecture design studio based in Ho Chi Minh City, Viet Nam.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "93/10 No Trang Long, Binh Loi Trung Ward",
        "addressLocality": "Ho Chi Minh City",
        "addressCountry": "VN"
      },
      "email": contact.email
    })} />
  </Fragment>

  <div class="landing">
    <!-- Brand mark centered like the mobile reference -->
    <a class="brand-wrapper" href="/" aria-label="KHONG architects — back to home">
      <img
        class="brand"
        src="/hotlink-ok/khong-logo.png"
        alt="KHONG architects"
        width="720"
        height="711"
        decoding="async"
        fetchpriority="high"
      />
    </a>
  </div>

  <!-- Lotus linework band above the fixed contact line -->
  <div class="lotus" data-background-src="/hotlink-ok/lotus-linework.avif" aria-hidden="true"></div>

  <!-- Fixed contact line (landing keeps it pinned at the very bottom) -->
  <footer class="contact" aria-label="Studio contact information">
    <address>
      <span class="contact-address">
        <span class="address-line">Ad : {contact.addressLine}</span>
        <span class="address-line">{contact.cityLine}</span>
      </span>
      <span class="sep" aria-hidden="true">/</span>
      <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
    </address>
  </footer>

  <noscript>
    <style>
      .lotus {
        background-image: url("/hotlink-ok/lotus-linework.avif");
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </noscript>

  <script>
    const lotusBackground = document.querySelector(".lotus");

    function revealLotusBackground() {
      if (!(lotusBackground instanceof HTMLElement)) return;
      const source = lotusBackground.dataset.backgroundSrc;
      if (!source) return;

      const image = new Image();
      image.decoding = "async";
      image.onload = () => {
        lotusBackground.style.backgroundImage = `url("${source}")`;
        requestAnimationFrame(() => {
          lotusBackground.classList.add("is-loaded");
        });
      };
      image.src = source;
    }

    window.addEventListener("load", () => {
      const scheduleIdle =
        window.requestIdleCallback ?? ((callback) => window.setTimeout(callback, 180));
      scheduleIdle(revealLotusBackground, { timeout: 900 });
    });
  </script>
</Layout>

<style is:global>
  .landing {
    position: relative;
    flex: 1;
    display: block;
    height: calc(100svh - var(--header-h)); /* fit exactly one screen */
    overflow: hidden;
    padding: 0;
  }

  .brand-wrapper {
    position: fixed;
    /* The source logo includes transparent top padding visible in the reference crop. */
    top: clamp(-6rem, -9vh, -4rem);
    left: 50%;
    z-index: 4;
    display: block;
    padding: 0;
    transform: translateX(-50%);
  }

  /* Large on desktop, shrinks toward the mobile reference proportion */
  /* Height cap keeps it inside the space above the lotus band */
  .brand {
    display: block;
    width: clamp(24rem, 31vw, 34rem);
    max-width: calc(100vw - 2rem);
    min-width: 0;
    height: auto;
    object-fit: contain;
    margin: 0 auto;
  }

  /* ── Lotus band ── */
  .lotus {
    position: fixed;
    z-index: 2;
    right: 0;
    bottom: clamp(2.7rem, 5vh, 4.5rem);
    left: 0;
    height: clamp(24rem, 64vh, 40rem);
    /* keep the top edge soft so the brand above stays readable */
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 14%);
    mask-image: linear-gradient(to bottom, transparent 0%, #000 14%);
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center bottom;
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 1100ms ease,
      transform 1100ms ease;
    pointer-events: none;
    user-select: none;
  }

  .lotus.is-loaded {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Fixed bottom contact line ── */
  .contact {
    position: fixed;
    z-index: 7;
    right: 1rem;
    bottom: clamp(0.8rem, 2vh, 1.4rem);
    left: 1rem;
    color: var(--soft-ink);
    font-size: clamp(0.66rem, 0.82vw, 0.92rem);
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
  }

  /* Give contact text a solid backdrop so the lotus never bleeds through */
  .contact::before {
    content: "";
    position: absolute;
    inset: -0.6rem -1.5rem;
    z-index: -1;
    background: rgba(255, 255, 255, 0.97);
  }

  .contact address {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  .contact address > span:first-child {
    max-width: 100%;
  }

  .contact-address {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .contact-address .address-line + .address-line::before {
    content: " - ";
  }

  .contact a {
    transition: color 140ms ease;
  }

  .contact a:hover {
    color: var(--ink);
  }

  /* ── Responsive: mobile mirrors the reference image ── */
  @media (max-width: 768px) {
    .landing {
      min-height: 100svh;
      height: auto;
      padding: 0 1rem 16rem;
      overflow: hidden;
    }

    .brand-wrapper {
      position: absolute;
      top: clamp(2rem, 7vh, 4rem);
      left: 50%;
      padding: 0;
      transform: translateX(-50%);
    }

    .brand {
      width: min(72vw, 20rem);
    }

    .lotus {
      height: clamp(14rem, 30vh, 17rem);
      bottom: clamp(4.6rem, 8vh, 6rem);
      background-size: cover;
    }

    .contact address {
      flex-direction: column;
      white-space: normal;
      gap: 0.15rem;
    }

    .contact address > span:first-child {
      max-width: min(100%, 29rem);
      line-height: 1.5;
    }

    .contact-address {
      flex-direction: column;
      gap: 0.15rem;
      max-width: 100%;
    }

    .contact-address .address-line + .address-line::before {
      content: "";
    }

    .contact .sep {
      display: none;
    }
  }
</style>
