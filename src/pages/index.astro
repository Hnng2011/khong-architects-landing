---
import RouteLoading from "../components/RouteLoading.astro";

const navItems = [
  { label: "Project", href: "/project/" },
  { label: "Concept", href: "/concept/" },
  { label: "Prize", href: "/prize/" },
];

const contact = {
  address: "93/10 No Trang Long, Binh Loi Trung Ward, Ho Chi Minh City, Viet Nam",
  phone: "0913 771 489",
  email: "khongarch@gmail.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="KHONG architects studio in Ho Chi Minh City, Viet Nam. Explore projects, concepts, awards, and contact information."
    />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href="https://khongarchitects.vn/" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-48x48.png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KHONG architects" />
    <meta property="og:title" content="KHONG architects" />
    <meta
      property="og:description"
      content="Architecture studio landing page for KHONG architects in Ho Chi Minh City, Viet Nam."
    />
    <meta property="og:image" content="/assets/og-image.jpg" />
    <meta property="og:url" content="https://khongarchitects.vn/" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href="/assets/khong-logo.png" as="image" />
    <title>KHONG architects</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <main id="main" class="landing" aria-labelledby="page-title">
      <h1 id="page-title" class="sr-only">KHONG architects</h1>

      <img
        class="brand"
        src="/assets/khong-logo.png"
        alt="KHONG architects"
        width="720"
        height="711"
        decoding="async"
        fetchpriority="high"
      />

      <nav class="site-nav" aria-label="Primary navigation">
        {
          navItems.map((item) => (
            <a class="nav-link" href={item.href}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </main>

    <div class="lotus" data-background-src="/assets/lotus-linework.avif" aria-hidden="true"></div>

    <footer class="contact" aria-label="Studio contact information">
      <address>
        <span>Address: {contact.address}</span>
        <span aria-hidden="true">/</span>
        <a href={`tel:${contact.phone.replaceAll(" ", "")}`}>Phone: {contact.phone}</a>
        <span aria-hidden="true">/</span>
        <a href={`mailto:${contact.email}`}>Email: {contact.email}</a>
      </address>
    </footer>

    <RouteLoading />

    <noscript>
      <style>
        .lotus {
          background-image: url("/assets/lotus-linework.avif");
          opacity: 1;
          transform: translateY(0);
        }
      </style>
    </noscript>

    <script>
      const lotusBackground = document.querySelector(".lotus");

      function revealLotusBackground() {
        if (!(lotusBackground instanceof HTMLElement)) return;
        const source = lotusBackground.dataset.backgroundSrc;
        if (!source) return;

        const image = new Image();
        image.decoding = "async";
        image.onload = () => {
          lotusBackground.style.backgroundImage = `url("${source}")`;
          requestAnimationFrame(() => {
            lotusBackground.classList.add("is-loaded");
          });
        };
        image.src = source;
      }

      window.addEventListener("load", () => {
        const scheduleIdle = window.requestIdleCallback ?? ((callback) => window.setTimeout(callback, 180));
        scheduleIdle(revealLotusBackground, { timeout: 900 });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #ffffff;
    --ink: #1b1b1b;
    --soft-ink: #6f6f6f;
    --focus: #a00000;
    --font-mono: "Courier New", Courier, monospace;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--paper);
    font-family: var(--font-mono);
    text-size-adjust: 100%;
  }

  body {
    min-height: 100svh;
    margin: 0;
    overflow: hidden;
    background: var(--paper);
    color: var(--ink);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: #6f6f6f;
  }

  a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 0.32rem;
  }

  .skip-link {
    position: fixed;
    z-index: 8;
    top: 1rem;
    left: 1rem;
    transform: translateY(-160%);
    border: 1px solid var(--ink);
    background: var(--paper);
    padding: 0.55rem 0.8rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .landing {
    position: relative;
    min-height: 100svh;
    background: transparent;
  }

  .brand {
    position: absolute;
    z-index: 5;
    top: clamp(2rem, 4.9vh, 4rem);
    left: 50%;
    width: min(18.4vw, 18rem);
    min-width: 11.8rem;
    height: auto;
    transform: translateX(-50%);
    object-fit: contain;
  }

  .site-nav {
    position: absolute;
    z-index: 6;
    top: clamp(2.1rem, 4.6vh, 4rem);
    right: clamp(1.4rem, 2.45vw, 3.2rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.28rem;
    color: var(--soft-ink);
    font-size: clamp(1.02rem, 1.25vw, 1.65rem);
    font-weight: 700;
    line-height: 1.24;
    text-align: right;
  }

  .nav-link {
    min-height: 1.65rem;
    letter-spacing: 0;
  }

  .lotus {
    position: fixed;
    z-index: 2;
    right: 0;
    bottom: clamp(2.7rem, 5.8vh, 4.2rem);
    left: 0;
    width: 100%;
    height: clamp(27rem, 64vh, 38rem);
    background-image: none;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center bottom;
    opacity: 0;
    transform: translateY(0.65rem);
    transition:
      opacity 1100ms ease,
      transform 1100ms ease;
    pointer-events: none;
    user-select: none;
  }

  .lotus.is-loaded {
    opacity: 1;
    transform: translateY(0);
  }

  .contact {
    position: fixed;
    z-index: 7;
    right: 1rem;
    bottom: clamp(1rem, 2.65vh, 2.1rem);
    left: 1rem;
    color: #646464;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 0.82vw, 1.05rem);
    line-height: 1.35;
    text-align: center;
  }

  .contact address {
    display: flex;
    justify-content: center;
    gap: clamp(0.55rem, 1vw, 1.2rem);
    margin: 0;
    font-style: normal;
    white-space: nowrap;
  }

  @media (max-aspect-ratio: 4 / 3), (max-width: 720px) {
    body {
      overflow: hidden;
    }

    .brand {
      top: clamp(7rem, 8.1vh, 10rem);
      width: min(45vw, 18rem);
      min-width: 15rem;
    }

    .site-nav {
      top: 44.5%;
      right: 50%;
      align-items: center;
      gap: clamp(0.72rem, 1.55vh, 1.2rem);
      transform: translate(50%, -50%);
      font-size: clamp(1.8rem, 4.7vw, 3rem);
      line-height: 1.12;
      text-align: center;
    }

    .nav-link {
      min-height: 2.35rem;
    }

    .lotus {
      bottom: clamp(6.8rem, 12.3vh, 10rem);
      height: clamp(15.5rem, 35vh, 20rem);
      background-position: center bottom;
    }

    .contact {
      bottom: clamp(1.6rem, 3vh, 3rem);
      font-size: clamp(1.02rem, 2.5vw, 1.45rem);
      line-height: 1.72;
    }

    .contact address {
      flex-direction: column;
      align-items: center;
      gap: 0;
      white-space: normal;
    }

    .contact span[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .brand {
      top: clamp(4rem, 7.8vh, 6rem);
      width: min(53vw, 14rem);
      min-width: 11.5rem;
    }

    .site-nav {
      top: 43.8%;
      font-size: clamp(1.5rem, 7.4vw, 2.25rem);
    }

    .lotus {
      bottom: clamp(7.5rem, 15.4vh, 9rem);
      height: clamp(13.4rem, 30vh, 16.5rem);
    }

    .contact {
      right: 0.9rem;
      left: 0.9rem;
      font-size: clamp(0.86rem, 3.8vw, 1.05rem);
    }
  }

  @media (max-height: 520px) and (orientation: landscape) {
    .brand {
      top: 1rem;
      width: min(14vw, 9rem);
      min-width: 7.6rem;
    }

    .site-nav {
      top: 1.1rem;
      font-size: 0.95rem;
    }

    .lotus {
      bottom: 2rem;
      width: 96%;
      left: 2%;
      height: 44vh;
    }

    .contact {
      bottom: 0.65rem;
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
    }

    .lotus {
      transition: none;
      transform: none;
    }
  }
</style>
