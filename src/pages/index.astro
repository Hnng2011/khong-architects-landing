---
import Layout from "../layouts/Layout.astro";

const contactEmail = "khongarch@gmail.com";
---

<Layout
  title="KHONG architects — Architectural Studio in Ho Chi Minh City, Viet Nam"
  description="KHONG architects studio in Ho Chi Minh City, Viet Nam. Explore projects, concepts, awards, and contact information."
  canonicalPath="/"
  active="Home"
>
  <Fragment slot="structured-data">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ArchitecturalStudio",
      "name": "KHONG architects",
      "url": "https://khongvietnam.com/",
      "logo": "https://khongvietnam.com/hotlink-ok/khong-logo-new.jpg",
      "image": "https://khongvietnam.com/hotlink-ok/khong-logo-new.jpg",
      "description": "KHONG architects is an architecture design studio based in Ho Chi Minh City, Viet Nam.",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "93/10 No Trang Long, Binh Loi Trung Ward",
        "addressLocality": "Ho Chi Minh City",
        "addressCountry": "VN"
      },
      "email": contactEmail
    })} />
  </Fragment>

  <div class="landing">
    <!-- Use the supplied logo artwork intact. -->
    <a class="brand-wrapper" href="/" aria-label="KHONG architects — back to home">
      <img
        class="brand"
        src="/hotlink-ok/khong-logo-new.jpg"
        alt=""
        width="2215"
        height="2560"
        decoding="async"
        fetchpriority="high"
      />
    </a>

    <!-- Lotus artwork sits above the footer on mobile. -->
    <div class="lotus" data-background-src="/hotlink-ok/lotus-linework.avif" aria-hidden="true"></div>
  </div>

  <noscript>
    <style>
      .lotus {
        background-image: url("/hotlink-ok/lotus-linework.avif");
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </noscript>

  <script>
    const lotusBackground = document.querySelector(".lotus");

    function revealLotusBackground() {
      if (!(lotusBackground instanceof HTMLElement)) return;
      const source = lotusBackground.dataset.backgroundSrc;
      if (!source) return;

      const image = new Image();
      image.decoding = "async";
      image.onload = () => {
        lotusBackground.style.backgroundImage = `url("${source}")`;
        requestAnimationFrame(() => {
          lotusBackground.classList.add("is-loaded");
        });
      };
      image.src = source;
    }

    window.addEventListener("load", () => {
      const scheduleIdle =
        window.requestIdleCallback ?? ((callback) => window.setTimeout(callback, 180));
      scheduleIdle(revealLotusBackground, { timeout: 900 });
    });
  </script>
</Layout>

<style is:global>
  .home-page .site-main {
    flex: none;
  }

  .landing {
    position: relative;
    flex: none;
    height: max(100svh, 780px);
    overflow: hidden;
  }

  .brand-wrapper {
    position: absolute;
    width: clamp(240px, 23vw, 470px);
    max-width: calc(100vw - 2rem);
    top: -30px;
    left: 50%;
    z-index: 4;
    display: block;
    padding: 0;
    transform: translateX(-50%);
    mix-blend-mode: multiply;
  }

  .brand {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Lotus band ── */
  .lotus {
    position: absolute;
    z-index: 2;
    right: 0;
    top: max(296px, calc(100% - 821px));
    left: 0;
    height: 750px;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center top;
    opacity: 0;
    transform: translateY(0.6rem);
    transition:
      opacity 1100ms ease,
      transform 1100ms ease;
    pointer-events: none;
    user-select: none;
  }

  .lotus.is-loaded {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Responsive: mobile mirrors the reference image ── */
  @media (max-width: 768px) {
    .home-page .site-main {
      flex: 1;
      min-height: 0;
    }

    .landing {
      height: 100%;
    }

    .brand-wrapper {
      width: min(55vw, 235px);
      top: 17px;
    }

    .lotus {
      /* Preserve the source image's 1800 × 798 aspect ratio. */
      top: max(440px, calc(100% - 44.333vw));
      height: 44.333vw;
      background-size: 100% auto;
    }
  }
</style>
